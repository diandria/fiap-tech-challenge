// Mirrors docs/architecture/data-model.md, the source of truth for the schema.
// CHECK constraints are not expressible here and live as SQL in the initial migration.

generator client {
  provider        = "prisma-client-js"
  // Required for Prisma to emit spans: it talks to its own query engine rather
  // than the pg driver, so pg instrumentation sees nothing.
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxType {
  CPF
  CNPJ
}

enum UserRole {
  attendant
  mechanic
  admin
}

enum OSStatus {
  RECEIVED
  DIAGNOSIS
  WAITING_APPROVAL
  APPROVED
  PAID
  EXECUTION
  FINISHED
  DELIVERED
  REJECTED
  CANCELLED
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  taxId     String    @unique @map("tax_id")
  taxType   TaxType   @map("tax_type")
  email     String
  phone     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]

  @@index([taxId])
  @@map("customers")
}

model Vehicle {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  plate      String @unique
  brand      String
  model      String
  year       Int

  customer      Customer       @relation(fields: [customerId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id               String  @id @default(uuid()) @db.Uuid
  name             String
  price            Decimal @db.Decimal(10, 2)
  estimatedMinutes Int     @map("estimated_minutes")

  serviceOrders ServiceOrderService[]

  @@map("services")
}

model Item {
  id               String  @id @default(uuid()) @db.Uuid
  name             String
  price            Decimal @db.Decimal(10, 2)
  stockQuantity    Int     @default(0) @map("stock_quantity")
  reservedQuantity Int     @default(0) @map("reserved_quantity")

  serviceOrders ServiceOrderItem[]

  @@map("items")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole

  @@map("users")
}

model ServiceOrder {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  status      OSStatus  @default(RECEIVED)
  budgetTotal Decimal?  @map("budget_total") @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  deliveredAt DateTime? @map("delivered_at")
  version     Int       @default(0)

  customer      Customer                    @relation(fields: [customerId], references: [id])
  vehicle       Vehicle                     @relation(fields: [vehicleId], references: [id])
  services      ServiceOrderService[]
  items         ServiceOrderItem[]
  statusHistory ServiceOrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("service_orders")
}

model ServiceOrderService {
  id             String    @id @default(uuid()) @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  serviceId      String    @map("service_id") @db.Uuid

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([serviceOrderId, serviceId])
  @@map("service_order_services")
}

model ServiceOrderItem {
  id             String @id @default(uuid()) @db.Uuid
  serviceOrderId String @map("service_order_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  quantity       Int

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])

  @@unique([serviceOrderId, itemId])
  @@map("service_order_items")
}

model ServiceOrderStatusHistory {
  id             String    @id @default(uuid()) @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  fromStatus     OSStatus? @map("from_status")
  toStatus       OSStatus  @map("to_status")
  changedAt      DateTime  @default(now()) @map("changed_at")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId, changedAt])
  @@map("service_order_status_history")
}

// Messages waiting to be published, written in the same transaction as the
// change that produced them. The relay publishes and marks them.
model OutboxMessage {
  id             String    @id @db.Uuid
  destination    String
  type           String
  serviceOrderId String    @map("service_order_id") @db.Uuid
  payload        Json
  traceparent    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_messages")
}

// Ids of messages already handled. Recording the id in the same transaction as
// the effect makes a redelivered message produce no effect the second time.
model ProcessedMessage {
  messageId   String   @id @map("message_id") @db.Uuid
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_messages")
}
