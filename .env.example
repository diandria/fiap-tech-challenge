PORT=3000
LOG_LEVEL=info
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Must match /car-repair-shop/auth/internal-token in SSM: a divergence fails
# customer authentication with a 401 and no useful message.
INTERNAL_TOKEN=change-me-must-match-the-auth-lambda
# console (default) logs the notification; sns publishes to the topic and makes
# SNS_TOPIC_ARN required.
NOTIFICATION_CHANNEL=console
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:car-repair-shop-service-order-events

# Saga queues. Locally they live in the LocalStack container of
# docker-compose.yml, created by scripts/localstack/create-queues.sh; on AWS the
# deploy fills these from the real queues and AWS_ENDPOINT_URL stays unset.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=us-east-1
# QUEUE_URL_BILLING_COMMANDS=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/car-repair-shop-billing-commands.fifo
# QUEUE_URL_EXECUTION_COMMANDS=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/car-repair-shop-execution-commands.fifo
# QUEUE_URL_SAGA_REPLIES=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/car-repair-shop-saga-replies.fifo

CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@master.com
ADMIN_PASSWORD=change-me-in-production
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=

DATABASE_URL="postgresql://oficina:oficina@localhost:5432/car_repair_shop?schema=public"

# Without OTEL_EXPORTER_OTLP_ENDPOINT the tracing SDK stays off and the
# application generates its own correlation ids: no collector needed locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=car-repair-shop-api
SERVICE_VERSION=0.0.0

# Numero de proxies a confiar no X-Forwarded-For. 0 (padrao) faz o Express usar
# o endereco do socket, correto em execucao local. No ambiente implantado use 1,
# que corresponde ao API Gateway -- sem isso o rate limit conta por ENI do
# gateway e nao por chamador. Veja ADR-012.
TRUST_PROXY_HOPS=0
LOGIN_RATE_LIMIT=30
