PORT=3000
LOG_LEVEL=info
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Shared secret with the token-issuing function. It has to match the value at
# /car-repair-shop/auth/internal-token in SSM: if they diverge, customer
# authentication fails with a 401 and no useful message.
INTERNAL_TOKEN=change-me-must-match-the-auth-lambda
# console (default) writes the notification to the log; sns publishes to the
# topic. With sns, SNS_TOPIC_ARN is required -- the application refuses to start
# without it.
NOTIFICATION_CHANNEL=console
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:car-repair-shop-service-order-events

CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@master.com
ADMIN_PASSWORD=change-me-in-production
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=

DATABASE_URL="postgresql://oficina:oficina@localhost:5432/car_repair_shop?schema=public"

# Observability. Without OTEL_EXPORTER_OTLP_ENDPOINT the tracing SDK does not
# start, and the application generates the correlation identifiers on its own:
# running locally does not require a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=car-repair-shop-api
SERVICE_VERSION=0.0.0
