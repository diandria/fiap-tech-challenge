PORT=3000
LOG_LEVEL=info
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Segredo compartilhado com a function emissora de token. Precisa ser
# identico ao valor em /car-repair-shop/auth/internal-token no SSM: se
# divergir, a autenticacao de cliente falha com 401 e sem mensagem util.
INTERNAL_TOKEN=change-me-must-match-the-auth-lambda
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@master.com
ADMIN_PASSWORD=change-me-in-production
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=

DATABASE_URL="postgresql://oficina:oficina@localhost:5432/car_repair_shop?schema=public"

# Observabilidade. Sem OTEL_EXPORTER_OTLP_ENDPOINT o SDK de tracing nao sobe, e a
# aplicacao gera os identificadores de correlacao por conta propria: rodar local
# nao exige um coletor.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=car-repair-shop-api
SERVICE_VERSION=0.0.0
