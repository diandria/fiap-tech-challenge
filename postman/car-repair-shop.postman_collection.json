              "raw": "{{baseUrl}}/service-orders/{{osRejectId}}/finish-diagnosis",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders", "{{osRejectId}}", "finish-diagnosis"]
            }
          }
        },
        {
          "name": "[Publico] Reject Budget (codigo 5299)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status REJECTED', () => pm.expect(pm.response.json().status).to.eql('REJECTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{customerCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/service-orders/{{osRejectId}}/reject-budget",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders", "{{osRejectId}}", "reject-budget"]
            }
          }
        },
        {
          "name": "Verificar Item Liberado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('reservedQuantity nao conta a OS rejeitada', () => {",
                  "  pm.expect(body.reservedQuantity).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{itemId}}"]
            }
          }
        }
