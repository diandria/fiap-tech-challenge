                  "  pm.environment.set('attendantId', body.id);",
                  "  pm.test('status 201', () => pm.response.to.have.status(201));",
                  "} else if (pm.response.code === 409) {",
                  "  pm.test('usuario ja existia (409) - ok em rodadas repetidas', () => pm.expect(pm.response.code).to.eql(409));",
                  "} else {",
                  "  pm.test('status 201 ou 409', () => pm.expect([201,409]).to.include(pm.response.code));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
